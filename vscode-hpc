#!/usr/bin/env bash
# Allocate one Slurm compute node and open it with VS Code Remote-SSH, or
# cancel matching allocations on the configured HPC login node.

set -euo pipefail

main_usage() {
  cat <<'EOF'
Usage:
  vscode-hpc open [options] FOLDER
  vscode-hpc cancel [--dry-run] [<slurm_job_id> | --all]
  vscode-hpc --help

Commands:
  open    Request an interactive-style Slurm allocation and open a folder in VS Code
  cancel  List or cancel your matching Slurm jobs named "vscode"

Run `vscode-hpc <command> --help` for command-specific help.
EOF
}

open_usage() {
  cat <<'EOF'
Usage: vscode-hpc open [options] FOLDER

Request an interactive-style Slurm allocation, wait for its compute node, and
open FOLDER in a VS Code Remote-SSH window.

Options:
  --time HH:MM:SS       Override VSCODE_HPC_TIME
  --cpus N              Override VSCODE_HPC_CPUS
  --mem SIZE            Override VSCODE_HPC_MEMORY
  --partition NAME      Override VSCODE_HPC_PARTITION
  --account NAME        Override VSCODE_HPC_ACCOUNT
  --help                Show this help

Required environment variables:
  VSCODE_HPC_HOST       Hostname of the HPC login node
  VSCODE_HPC_USER       Username used to log in to the HPC
  VSCODE_HPC_TIME       Slurm wall time, e.g. 04:00:00
  VSCODE_HPC_CPUS       CPUs per task, e.g. 4
  VSCODE_HPC_MEMORY     Memory request, e.g. 8G

Optional environment variables:
  VSCODE_HPC_PARTITION  Slurm partition
  VSCODE_HPC_ACCOUNT    Slurm account/project

Examples:
  export VSCODE_HPC_HOST=login.hpc.example VSCODE_HPC_USER=my-username
  export VSCODE_HPC_TIME=04:00:00 VSCODE_HPC_CPUS=4 VSCODE_HPC_MEMORY=8G
  vscode-hpc open /home/me/project
  vscode-hpc open --time 02:00:00 /home/me/project
EOF
}

cancel_usage() {
  cat <<'EOF'
Usage:
  vscode-hpc cancel [--dry-run]
  vscode-hpc cancel [--dry-run] <slurm_job_id>
  vscode-hpc cancel [--dry-run] --all

List or cancel your Slurm jobs named "vscode" on the configured HPC login node.

Options:
  --all      Cancel all matching jobs
  --dry-run  List matching jobs without cancelling them
  --help     Show this help

Required environment variables:
  VSCODE_HPC_HOST  Hostname of the HPC login node
  VSCODE_HPC_USER  Username used to log in to the HPC

Example:
  export VSCODE_HPC_HOST=login.hpc.example VSCODE_HPC_USER=my-username
  vscode-hpc cancel
EOF
}

open_main() {
  local HPC_HOST="${VSCODE_HPC_HOST:-}"
  local HPC_USER="${VSCODE_HPC_USER:-}"
  local TIME="${VSCODE_HPC_TIME:-}"
  local CPUS="${VSCODE_HPC_CPUS:-}"
  local MEMORY="${VSCODE_HPC_MEMORY:-}"
  local PARTITION="${VSCODE_HPC_PARTITION:-}"
  local ACCOUNT="${VSCODE_HPC_ACCOUNT:-}"
  local FOLDER=""
  local REMOTE_CMD=""
  local LOGIN_TARGET=""
  local JOB_ID=""
  local NODE=""
  local STATE=""
  local INFO=""
  local escaped=""
  local SBATCH=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --time) TIME="$2"; shift 2 ;;
      --cpus) CPUS="$2"; shift 2 ;;
      --mem) MEMORY="$2"; shift 2 ;;
      --partition) PARTITION="$2"; shift 2 ;;
      --account) ACCOUNT="$2"; shift 2 ;;
      --help|-h) open_usage; exit 0 ;;
      --) shift; break ;;
      -*) echo "Unknown option: $1" >&2; open_usage >&2; exit 2 ;;
      *)
        [[ -z "$FOLDER" ]] || { echo "Only one folder argument is allowed." >&2; open_usage >&2; exit 2; }
        FOLDER="$1"
        shift
        ;;
    esac
  done

  if [[ $# -gt 0 ]]; then
    [[ -z "$FOLDER" ]] || { echo "Only one folder argument is allowed." >&2; open_usage >&2; exit 2; }
    FOLDER="$1"
    shift
  fi

  [[ $# -eq 0 ]] || { echo "Only one folder argument is allowed." >&2; open_usage >&2; exit 2; }

  [[ -n "$HPC_HOST" ]] || { echo "Missing required environment variable: VSCODE_HPC_HOST" >&2; exit 2; }
  [[ -n "$HPC_USER" ]] || { echo "Missing required environment variable: VSCODE_HPC_USER" >&2; exit 2; }
  [[ -n "$TIME" ]] || { echo "Missing required environment variable: VSCODE_HPC_TIME" >&2; exit 2; }
  [[ -n "$CPUS" ]] || { echo "Missing required environment variable: VSCODE_HPC_CPUS" >&2; exit 2; }
  [[ -n "$MEMORY" ]] || { echo "Missing required environment variable: VSCODE_HPC_MEMORY" >&2; exit 2; }
  [[ -n "$FOLDER" ]] || { echo "A folder argument is required and must be a path on the HPC filesystem." >&2; exit 2; }

  if ! command -v code >/dev/null 2>&1; then
    echo "The VS Code 'code' command is not on PATH." >&2
    echo "In VS Code, run: Shell Command: Install 'code' command in PATH" >&2
    exit 2
  fi

  SBATCH=(sbatch --parsable --job-name=vscode --nodes=1 --ntasks=1
    --cpus-per-task="$CPUS" --mem="$MEMORY" --time="$TIME"
    --output=/dev/null --error=/dev/null)
  [[ -n "$PARTITION" ]] && SBATCH+=(--partition="$PARTITION")
  [[ -n "$ACCOUNT" ]] && SBATCH+=(--account="$ACCOUNT")
  SBATCH+=(--wrap='trap "exit 0" TERM INT; while :; do sleep 3600; done')

  for arg in "${SBATCH[@]}"; do
    printf -v escaped '%q' "$arg"
    REMOTE_CMD+="${escaped} "
  done

  LOGIN_TARGET="${HPC_USER}@${HPC_HOST}"

  echo "Requesting a compute node via ${LOGIN_TARGET}..."
  JOB_ID="$(ssh "$LOGIN_TARGET" "$REMOTE_CMD")"
  JOB_ID="${JOB_ID%%;*}"
  if [[ ! "$JOB_ID" =~ ^[0-9]+$ ]]; then
    echo "Slurm did not return a job ID: $JOB_ID" >&2
    exit 1
  fi
  echo "Job ${JOB_ID} submitted; waiting for a node (Ctrl-C will not cancel it)."

  while :; do
    INFO="$(ssh "$LOGIN_TARGET" "squeue --noheader --jobs=${JOB_ID} --format='%T %N'" | head -n 1 || true)"
    if [[ -z "$INFO" ]]; then
      echo "Job ${JOB_ID} disappeared before an allocation was available." >&2
      exit 1
    fi
    STATE="${INFO%% *}"
    NODE="${INFO#* }"
    if [[ "$STATE" == "RUNNING" && -n "$NODE" && "$NODE" != "(null)" ]]; then
      break
    fi
    printf '  state: %s\r' "$STATE"
    sleep 5
  done
  printf '\nAllocated node: %s (job %s)\n' "$NODE" "$JOB_ID"

  echo "Opening VS Code on ${NODE}..."
  code --remote "ssh-remote+${NODE}" "$FOLDER"

  cat <<EOF

When you are done, release the allocation:
  ssh ${LOGIN_TARGET} scancel ${JOB_ID}
EOF
}

cancel_main() {
  local HPC_HOST="${VSCODE_HPC_HOST:-}"
  local HPC_USER="${VSCODE_HPC_USER:-}"
  local DRY_RUN=0
  local MODE="list"
  local TARGET_JOB_ID=""
  local CANCEL_ALL=0
  local LOGIN_TARGET=""
  local JOBS=""
  local JOB_IDS=()
  local job_id=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) CANCEL_ALL=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --help|-h) cancel_usage; exit 0 ;;
      -*) echo "Unknown option: $1" >&2; cancel_usage >&2; exit 2 ;;
      *)
        [[ "$CANCEL_ALL" -eq 0 ]] || { echo "Cannot use --all with a job ID argument." >&2; cancel_usage >&2; exit 2; }
        [[ -z "$TARGET_JOB_ID" ]] || { echo "Only one job ID argument is allowed." >&2; cancel_usage >&2; exit 2; }
        TARGET_JOB_ID="$1"
        MODE="one"
        shift
        ;;
    esac
  done

  if [[ "$CANCEL_ALL" -eq 1 ]]; then
    MODE="all"
  fi

  [[ -n "$HPC_HOST" ]] || { echo "Missing required environment variable: VSCODE_HPC_HOST" >&2; exit 2; }
  [[ -n "$HPC_USER" ]] || { echo "Missing required environment variable: VSCODE_HPC_USER" >&2; exit 2; }

  LOGIN_TARGET="${HPC_USER}@${HPC_HOST}"
  JOBS="$(ssh "$LOGIN_TARGET" "squeue --me --name=vscode --noheader --format='%i %T %N'")"

  if [[ -n "$TARGET_JOB_ID" && ! "$TARGET_JOB_ID" =~ ^[0-9]+$ ]]; then
    echo "Invalid job ID: ${TARGET_JOB_ID}" >&2
    exit 2
  fi

  if [[ "$MODE" == "list" ]]; then
    if [[ -z "$JOBS" ]]; then
      echo "No Slurm jobs named 'vscode' found for ${LOGIN_TARGET}."
      exit 0
    fi
    echo "Cancellable Slurm jobs on ${LOGIN_TARGET}:"
    printf '%s\n' "$JOBS"
    exit 0
  fi

  if [[ "$MODE" == "one" ]]; then
    if ! awk '{print $1}' <<<"$JOBS" | grep -qx "$TARGET_JOB_ID"; then
      echo "Job ID ${TARGET_JOB_ID} is not a cancellable 'vscode' job for ${LOGIN_TARGET}." >&2
      exit 1
    fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
      echo "Dry run: would cancel job ID ${TARGET_JOB_ID}."
      exit 0
    fi
    echo "Cancelling job ID: ${TARGET_JOB_ID}"
    ssh "$LOGIN_TARGET" scancel "$TARGET_JOB_ID"
    exit 0
  fi

  if [[ -z "$JOBS" ]]; then
    echo "No Slurm jobs named 'vscode' found for ${LOGIN_TARGET}."
    exit 0
  fi

  while IFS= read -r job_id; do
    JOB_IDS+=("$job_id")
  done < <(awk '{print $1}' <<<"$JOBS")

  echo "Cancellable Slurm jobs on ${LOGIN_TARGET}:"
  printf '%s\n' "$JOBS"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "Dry run: would cancel job IDs: ${JOB_IDS[*]}"
    exit 0
  fi

  echo "Cancelling job IDs: ${JOB_IDS[*]}"
  ssh "$LOGIN_TARGET" scancel "${JOB_IDS[@]}"
}

if [[ $# -eq 0 ]]; then
  main_usage >&2
  exit 2
fi

case "$1" in
  open)
    shift
    open_main "$@"
    ;;
  cancel)
    shift
    cancel_main "$@"
    ;;
  --help|-h)
    main_usage
    ;;
  *)
    open_main "$@"
    ;;
esac
